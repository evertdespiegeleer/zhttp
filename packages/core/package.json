{
  "name": "@zhttp/core",
  "version": "2.0.2",
  "description": "A minimal, strongly typed HTTP library with Zod validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/evertdespiegeleer/zhttp.git"
  },
  "license": "MIT",
  "author": "Evert De Spiegeleer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "types": "./dist/main.d.ts",
  "files": [
    "./dist",
    "./readme.md"
  ],
  "scripts": {
    "prepack": "cp ../../readme.md ./readme.md",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter spec --test-reporter-destination stdout --test-reporter junit --test-reporter-destination=./test-report.xml --loader ts-node/esm ./src/**/*.test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@zhttp/errors": "2.0.2",
    "@types/express": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "chai": "^5.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@zhttp/errors": "2.0.2",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": "^20.10.x",
    "npm": "^10.2.3"
  }
}
